# Biotech dashboard: environment reference. Placeholders only.
#
# Nothing is read from a .env file. Values are set in two places:
#   - local development: copy worker/.dev.vars.example to worker/.dev.vars
#   - production: `wrangler secret put <NAME>` for secrets, [vars] in
#     worker/wrangler.toml for the rest
#
# The frontend needs no environment variables and must never be given secrets.

# --- Secrets (production: wrangler secret put) ---
FINNHUB_API_KEY="replace-with-finnhub-key"

# --- Non-secret Worker variables (production: worker/wrangler.toml [vars]) ---
ACCESS_TEAM_DOMAIN="https://your-team.cloudflareaccess.com"
ACCESS_AUD="replace-with-access-application-audience-tag"
ADMIN_EMAILS="you@example.com"
ALLOWED_ORIGINS="https://jiayangzh.com"
DATA_MODE="live"

# --- Local development only; never set in production ---
DEV_ADMIN_EMAIL="dev@localhost"
