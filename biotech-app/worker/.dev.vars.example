# Local development secrets for `npm run dev:worker`. Copy to worker/.dev.vars
# (git-ignored). Placeholders only: never commit real values.

# Finnhub market-data key (https://finnhub.io). Not needed when DATA_MODE=mock.
FINNHUB_API_KEY="replace-with-finnhub-key"

# "mock" serves generated placeholder prices, labelled MOCK DATA in the UI.
DATA_MODE="mock"

# Origins allowed to call the API from a browser (local Jekyll server).
ALLOWED_ORIGINS="http://localhost:4000,http://127.0.0.1:4000"

# Local-only admin bypass. Honoured on localhost only; never set in production.
DEV_ADMIN_EMAIL="dev@localhost"
